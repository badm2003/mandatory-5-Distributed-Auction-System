syntax = "proto3"; 
import "google/protobuf/empty.proto";

option go_package = "./grpc";

package grpc;


service Auction {
    rpc Bid(BidRequest) returns (Acknowledgement);
    rpc Result(google.protobuf.Empty) returns (ResultReply);
}

service ReplicateService {
    rpc Replicate(AuctionState) returns (Acknowledgement);
    rpc Commit(CommitReqest) returns (google.protobuf.Empty);
}

message BidRequest {
    int64 amount = 1;
}

message Acknowledgement {
    string reply = 1;
}

message ResultReply {
    int64 outcome = 1;
}

message AuctionState {
    int64 seq = 1;
    int64 bid = 2;
}

message CommitRequest {
    int64 seq = 1;
}


message Heartbeat {
    bool reply = 1;
}
